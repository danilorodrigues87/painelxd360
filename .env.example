# Copie para .env e preencha (nunca commitar o .env)

URL=http://localhost/pjt/xd360
SITE=XD360

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=xd360

APP_KEY=
SYSTEM_TOKEN=
JWT_KEY=

# DoceFlow backend
# Produção: https://doceflow.xd360.com.br | Local Opção A: vazio (usa /doceflow/ no mesmo host)
DOCEFLOW_PUBLIC_URL=
PRODUCT_LAUNCH_SECRET=
MAINTENANCE=false
TIMEZONE=America/Sao_Paulo
 
MASTER_EMAILS=admin@xd360.com.br

# Mercado Pago (conta XD360)
MP_XD360_ACCESS_TOKEN=
MP_XD360_PUBLIC_KEY=
MP_XD360_WEBHOOK_SECRET=
MP_XD360_WEBHOOK_TOKEN=
MP_XD360_PAYER_EMAIL=

# Multi-tenant (subdomínios)
XD360_BASE_DOMAIN=xd360.com.br
XD360_MASTER_HOST=app.xd360.com.br
# Produção: https://app.xd360.com.br
XD360_MASTER_URL=http://localhost/pjt/xd360
# Em localhost, simula tenant pelo slug (ex.: cliente-teste)
XD360_DEV_TENANT_SLUG=

TOPAPPS_BASE=http://localhost/pjt/topapps/projetoshtml
